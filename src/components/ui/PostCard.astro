---
const { post, featured = false } = Astro.props;
const CAT_COLORS = { "c1":"#8b5cf6","c2":"#3b82f6","c3":"#10b981","c4":"#f59e0b","c5":"#ef4444" };
const color = post.category?.color || CAT_COLORS[post.categoryId] || "#6366f1";
---

<a href={`/blog/${post.slug}`} class="card" style={`display:block;text-decoration:none;${featured ? "grid;grid-template-columns:1.2fr 1fr;min-height:280px" : ""}`}>
  <div style={`position:relative;overflow:hidden;${featured ? "height:100%" : "height:200px"}`}>
    <img src={post.coverImage} alt={post.title} style="width:100%;height:100%;object-fit:cover;transition:transform .3s"/>
    <div style={`position:absolute;top:12px;left:12px;background:${color};color:#fff;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700`}>
      {post.category?.icon} {post.category?.name}
    </div>
    {post.featured && <div style="position:absolute;top:12px;right:12px;background:#f59e0b;color:#000;padding:4px 10px;border-radius:20px;font-size:10px;font-weight:800;letter-spacing:.5px">FEATURED</div>}
  </div>
  <div style={`padding:${featured ? "28px" : "18px 20px"}`}>
    {featured && (
      <div style="display:flex;gap:12px;margin-bottom:14px;font-size:12px;color:var(--color-muted)">
        <span>👁 {post.views?.toLocaleString()} views</span>
        <span>❤️ {post.likes} likes</span>
        <span>⏱ {post.readTime} min read</span>
      </div>
    )}
    <h3 style={`margin:0 0 10px;font-size:${featured ? "22px" : "16px"};font-weight:700;line-height:1.3;color:var(--color-text)`}>
      {post.title}
    </h3>
    <p style="margin:0 0 16px;font-size:14px;color:var(--color-muted);line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
      {post.excerpt}
    </p>
    <div style="display:flex;align-items:center;justify-content:space-between">
      <div style="display:flex;align-items:center;gap:8px">
        <img src={post.author?.avatar} alt={post.author?.name} style="width:28px;height:28px;border-radius:50%;object-fit:cover"/>
        <span style="font-size:13px;color:var(--color-muted)">{post.author?.name}</span>
      </div>
      {!featured && (
        <div style="display:flex;gap:10px;font-size:12px;color:var(--color-muted)">
          <span>⏱ {post.readTime}m</span>
          <span>👁 {(post.views/1000).toFixed(0)}k</span>
        </div>
      )}
    </div>
  </div>
</a>

<style>
  a:hover img { transform: scale(1.04); }
</style>
