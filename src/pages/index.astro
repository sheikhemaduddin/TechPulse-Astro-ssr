---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/ui/PostCard.astro";
import { getFeaturedPosts, getPosts, getCategories, getTopPosts } from "../lib/api.js";

let featured = [], latest = [], categories = [], topPosts = [];

try {
  [featured, latest, categories, topPosts] = await Promise.all([
    getFeaturedPosts().then(r => r.posts),
    getPosts({ limit: 6 }).then(r => r.posts),
    getCategories().then(r => r.categories),
    getTopPosts().then(r => r.posts),
  ]);
} catch (e) {
  console.error("Failed to fetch homepage data:", e.message);
}

const hero = featured[0];
const featuredRest = featured.slice(1, 3);
---

<BaseLayout title="Home" description="The latest in tech, AI, and development">
  <!-- Hero -->
  {hero && (
    <section style="padding:48px 0 0">
      <div class="container">
        <PostCard post={hero} featured={true}/>
      </div>
    </section>
  )}

  <!-- Featured Grid -->
  {featuredRest.length > 0 && (
    <section style="padding:32px 0 0">
      <div class="container">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
          {featuredRest.map(p => <PostCard post={p}/>)}
        </div>
      </div>
    </section>
  )}

  <!-- Categories -->
  <section style="padding:48px 0 0">
    <div class="container">
      <h2 style="margin:0 0 20px;font-size:22px;font-weight:800">Browse Topics</h2>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        {categories.map(c => (
          <a href={`/category/${c.slug}`} style={`display:flex;align-items:center;gap:8px;padding:10px 18px;border-radius:30px;border:1px solid ${c.color}40;background:${c.color}15;color:${c.color};font-size:14px;font-weight:600;transition:all .15s`}
            onmouseover={`this.style.background='${c.color}30'`} onmouseout={`this.style.background='${c.color}15'`}>
            {c.icon} {c.name} <span style="opacity:.6;font-size:12px">({c.postCount})</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Posts + Sidebar -->
  <section style="padding:48px 0">
    <div class="container" style="display:grid;grid-template-columns:1fr 320px;gap:32px;align-items:start">
      <div>
        <h2 style="margin:0 0 24px;font-size:22px;font-weight:800">Latest Articles</h2>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
          {latest.map(p => <PostCard post={p}/>)}
        </div>
        <div style="margin-top:24px;text-align:center">
          <a href="/blog" class="btn btn-outline">View All Articles →</a>
        </div>
      </div>
      <!-- Sidebar -->
      <aside style="position:sticky;top:80px">
        <div class="card" style="padding:20px;margin-bottom:20px">
          <h3 style="margin:0 0 16px;font-size:16px;font-weight:700">🔥 Trending</h3>
          {topPosts.map((p, i) => (
            <a href={`/blog/${p.slug}`} style="display:flex;gap:12px;align-items:flex-start;padding:10px 0;border-bottom:1px solid var(--color-border);text-decoration:none">
              <span style="font-size:22px;font-weight:800;color:var(--color-border);min-width:28px">{i+1}</span>
              <div>
                <p style="margin:0 0 4px;font-size:13px;font-weight:600;color:var(--color-text);line-height:1.4">{p.title}</p>
                <p style="margin:0;font-size:11px;color:var(--color-muted)">{(p.views/1000).toFixed(1)}k views</p>
              </div>
            </a>
          ))}
        </div>

        <!-- Newsletter -->
        <div class="card" style="padding:20px;background:linear-gradient(135deg,var(--color-accent),#8b5cf6)">
          <h3 style="margin:0 0 8px;font-size:16px;font-weight:700;color:#fff">📬 Newsletter</h3>
          <p style="margin:0 0 14px;font-size:13px;color:rgba(255,255,255,.8)">Get weekly tech digest in your inbox</p>
          <input placeholder="Your email address" style="width:100%;padding:9px 12px;border-radius:8px;border:none;font-size:13px;margin-bottom:8px;box-sizing:border-box"/>
          <button class="btn" style="width:100%;background:#fff;color:var(--color-accent);font-size:13px;padding:9px;justify-content:center">Subscribe →</button>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
