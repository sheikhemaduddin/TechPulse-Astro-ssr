{
  "name": "astro-frontend",
  "version": "1.0.0",
  "description": "TechPulse — Astro SSR frontend with pnpm",
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "mock-api": "node scripts/mock-api.mjs",
    "build": "astro build && node scripts/patch-vercel-runtime.mjs",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^8.1.0",
    "@astrojs/vercel": "^7.8.0",
    "@nanostores/persistent": "^0.9.1",
    "astro": "^4.3.2",
    "nanostores": "^0.9.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.4.1",
    "typescript": "^5.3.3"
  }
}
